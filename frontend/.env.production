# HR Allocate - Frontend Production Configurations
# Vite loads variables prefixed with VITE_ to be exposed to the client application.

# Base URL for PHP API calls.
# Keep this empty if the React frontend is hosted on the same server & port as the PHP backend.
# If they are hosted on separate servers/domains, define the absolute URL here.
# Example: VITE_API_URL=https://api.yourcompany.com
VITE_API_URL=
