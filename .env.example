# HR Allocate - Production Environment Configuration Template

# 1. Application Settings
ENV=production
ALLOWED_ORIGINS=http://your-production-frontend-domain.com

# 2. JWT Configuration
# IMPORTANT: Change this to a secure, long random string in production!
JWT_SECRET=HR_Payroll_Enterprise_Secret_Key_2026

# 3. Database Configuration (MySQL/MariaDB)
# Note: If MySQL fails to connect, the system will fall back to SQLite (backend/database.sqlite).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hr_payroll
DB_USERNAME=root
DB_PASSWORD=your_secure_password
